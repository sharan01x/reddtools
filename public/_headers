/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Access-Control-Allow-Origin: https://reddtools.com
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.posthog.com https://*.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.posthog.com https://*.i.posthog.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.google.com; frame-src https://googleads.g.doubleclick.net https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com; object-src 'none'; base-uri 'self'; form-action 'self'

# Static assets — long cache
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML — short cache
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Favicon
/favicon.svg
  Cache-Control: public, max-age=86400

# Sitemap
/sitemap-index.xml
  Cache-Control: public, max-age=3600
