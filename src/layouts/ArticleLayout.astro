---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  date: string;
  readTime: string;
  author?: string;
  keywords?: string[];
}

const { title, description, canonicalPath, date, readTime, author = 'ReddTools Team', keywords } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  url: `https://reddtools.com${canonicalPath}`,
  datePublished: date,
  dateModified: date,
  author: {
    '@type': 'Organization',
    name: author,
    url: 'https://reddtools.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ReddTools',
    logo: {
      '@type': 'ImageObject',
      url: 'https://reddtools.com/og-image.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://reddtools.com${canonicalPath}`,
  },
};
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} keywords={keywords}>
  <article class="article-page">
    <header class="article-header">
      <div class="article-meta">
        <span class="article-date">{date}</span>
        <span class="article-separator">·</span>
        <span class="article-readtime">{readTime}</span>
      </div>
      <h1>{title}</h1>
    </header>

    <div class="article-body">
      <slot />
    </div>

    <footer class="article-footer">
      <p>Written by the <strong>{author}</strong>. Have questions or feedback? <a href="/contact">Get in touch</a>.</p>
    </footer>
  </article>
</Layout>

<style>
  .article-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 64px 24px 120px;
  }

  .article-header {
    margin-bottom: 48px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: #999;
  }

  .article-separator {
    opacity: 0.5;
  }

  .article-header h1 {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #000;
    margin: 0;
  }

  .article-body {
    font-size: 17px;
    line-height: 1.8;
    color: #333;
  }

  .article-body :global(h2) {
    font-family: 'Inter', sans-serif;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.3;
    color: #000;
    margin: 48px 0 20px;
  }

  .article-body :global(h3) {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    color: #000;
    margin: 32px 0 16px;
  }

  .article-body :global(p) {
    margin: 0 0 20px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 20px;
    padding-left: 28px;
  }

  .article-body :global(li) {
    margin-bottom: 10px;
  }

  .article-body :global(a) {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(a:hover) {
    opacity: 0.6;
  }

  .article-body :global(strong) {
    color: #000;
    font-weight: 600;
  }

  .article-body :global(blockquote) {
    margin: 24px 0;
    padding: 16px 24px;
    border-left: 3px solid #000;
    background: #f5f5f5;
    font-style: italic;
  }

  .article-body :global(blockquote p) {
    margin: 0;
  }

  .article-footer {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .article-footer p {
    font-size: 14px;
    line-height: 1.6;
    color: #5b5b5b;
    margin: 0;
  }

  .article-footer a {
    color: #000;
    text-decoration: underline;
  }
</style>
