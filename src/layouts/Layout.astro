---
import '../styles/global.css';
import { tools, toolIconSvg } from '../lib/tools';

interface Props {
  title: string;
  description: string;
  activeTool?: string;
}

const { title, description, activeTool } = Astro.props;
const siteName = 'ReddTools';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <script is:inline>
    (function() {
      if (typeof window === 'undefined') return;
      if (location.hostname.includes('localhost')) return;
      var script = document.createElement('script');
      script.async = true;
      script.src = 'https://us-assets.i.posthog.com/posthog.js';
      script.onload = function() {
        if (window.posthog) {
          window.posthog.init('POSTHOG_KEY', { api_host: 'https://us.i.posthog.com', capture_pageview: true });
        }
      };
      document.head.appendChild(script);
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <nav class="nav-inner">
      <a href="/" class="logo">
        <svg class="logo-icon" viewBox="0 0 32 32" fill="none">
          <rect width="32" height="32" rx="6" fill="#000"/>
          <rect x="7" y="6" width="18" height="6" rx="1.5" fill="#fff"/>
          <rect x="7" y="15" width="4" height="4" rx="1" fill="#fff" opacity="0.7"/>
          <rect x="13" y="15" width="4" height="4" rx="1" fill="#fff" opacity="0.7"/>
          <rect x="19" y="15" width="4" height="4" rx="1" fill="#fff" opacity="0.7"/>
          <rect x="7" y="21" width="4" height="4" rx="1" fill="#fff" opacity="0.7"/>
          <rect x="13" y="21" width="4" height="4" rx="1" fill="#fff" opacity="0.7"/>
          <rect x="19" y="21" width="4" height="4" rx="1" fill="#fff" opacity="0.7"/>
        </svg>
        <span class="logo-text">ReddTools</span>
      </a>

      <div class="nav-links">
        {tools.map((tool) => (
          <a
            href={`/${tool.slug}`}
            class:list={['nav-link', activeTool === tool.slug ? 'active' : '']}
          >
            {tool.shortName}
          </a>
        ))}
      </div>

      <button class="nav-toggle" aria-label="Menu" id="nav-toggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="4" y1="8" x2="20" y2="8"/><line x1="4" y1="16" x2="20" y2="16"/></svg>
      </button>
    </nav>
    <div class="mobile-menu" id="mobile-menu">
      {tools.map((tool) => (
        <a
          href={`/${tool.slug}`}
          class:list={['mobile-nav-link', activeTool === tool.slug ? 'active' : '']}
        >
          {tool.shortName}
        </a>
      ))}
    </div>
  </header>

  <script is:inline>
    (function() {
      var btn = document.getElementById('nav-toggle');
      var menu = document.getElementById('mobile-menu');
      if (!btn || !menu) return;
      btn.addEventListener('click', function() { menu.classList.toggle('open'); });
      menu.querySelectorAll('a').forEach(function(a) {
        a.addEventListener('click', function() { menu.classList.remove('open'); });
      });
    })();
  </script>

  <main class="main-content">
    <slot />
  </main>

  {activeTool && (
    <div class="ad-section" style="margin-top: 48px;">
      <div class="ad-zone" aria-label="Advertisement">
        <span class="ad-label">Advertisement</span>
      </div>
    </div>
  )}

  {activeTool && (
    <section class="cross-promo">
      <div class="section-label">Other tools</div>
      <div class="promo-grid">
        {tools
          .filter(t => t.slug !== activeTool)
          .slice(0, 6)
          .map((tool) => (
            <a href={`/${tool.slug}`} class="promo-card">
              <div class="promo-icon" set:html={toolIconSvg[tool.slug] || ''} />
              <div class="promo-text">
                <div class="promo-name">{tool.shortName}</div>
                <div class="promo-desc">{tool.description}</div>
              </div>
            </a>
          ))}
      </div>
    </section>
  )}

  <footer class="site-footer">
    <div class="footer-content">
      <div class="footer-brand">ReddTools</div>
      <div class="footer-rule"></div>
      <div class="footer-caption">Built by Redd Group</div>
    </div>
  </footer>

  <style>
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(245, 245, 245, 0.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    }

    .nav-inner {
      position: relative;
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 74px;
    }

    @media (min-width: 768px) {
      .nav-inner {
        padding: 0 48px;
      }
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
    }

    .logo:hover {
      opacity: 0.6;
    }

    .logo-icon {
      width: 28px;
      height: 28px;
      flex-shrink: 0;
    }

    .logo-text {
      font-family: 'Inter', sans-serif;
      font-size: 1.05rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      color: #000;
    }

    .nav-links {
      display: flex;
      gap: 0;
      align-items: center;
    }

    .nav-link {
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 400;
      color: #000;
      text-decoration: none;
      padding: 0 15px;
      height: 74px;
      display: flex;
      align-items: center;
      transition: color 200ms ease;
      opacity: 1;
    }

    .nav-link:hover {
      opacity: 1;
      color: rgba(0, 0, 0, 0.6);
    }

    .nav-link.active {
      color: #000;
    }

    @media (max-width: 767px) {
      .nav-links {
        display: none;
      }
    }

    .nav-toggle {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      color: #000;
      -webkit-tap-highlight-color: transparent;
    }

    .nav-toggle svg { width: 24px; height: 24px; }

    .mobile-menu {
      display: none;
      position: absolute;
      top: 74px;
      left: 0;
      right: 0;
      background: #f5f5f5;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      padding: 8px 24px;
      z-index: 99;
    }

    .mobile-menu.open {
      display: flex;
      flex-direction: column;
    }

    .mobile-nav-link {
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      font-weight: 400;
      color: #5b5b5b;
      text-decoration: none;
      padding: 12px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    }

    .mobile-nav-link:last-child { border-bottom: none; }
    .mobile-nav-link.active { color: #000; }

    @media (max-width: 767px) {
      .nav-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
      }
    }

    .main-content {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 24px;
    }

    @media (min-width: 768px) {
      .main-content {
        padding: 0 48px;
      }
    }

    .ad-section {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 24px 24px;
    }

    @media (min-width: 768px) {
      .ad-section {
        padding: 0 48px 24px;
      }
    }

    .ad-zone {
      border-radius: 4px;
      background: #fff;
      border: 1px solid rgba(0, 0, 0, 0.04);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
      padding: 24px;
      text-align: center;
      min-height: 90px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ad-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #999;
    }

    .cross-promo {
      max-width: 1440px;
      margin: 0 auto;
      padding: 0 24px 48px;
    }

    @media (min-width: 768px) {
      .cross-promo {
        padding: 0 48px 48px;
      }
    }

    .section-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #999;
      margin-bottom: 16px;
    }

    .promo-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    @media (min-width: 768px) {
      .promo-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }
    }

    @media (min-width: 1024px) {
      .promo-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .promo-card {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 24px;
      background: #fff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 4px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
      text-decoration: none;
      transition: border-color 200ms ease, box-shadow 200ms ease;
      opacity: 1;
    }

    .promo-card:hover {
      opacity: 1;
      border-color: rgba(0, 0, 0, 0.15);
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
    }

    .promo-icon {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f5f5f5;
      border-radius: 4px;
      color: #000;
    }

    .promo-icon :global(svg) {
      width: 24px;
      height: 24px;
    }

    .promo-text {
      flex: 1;
      min-width: 0;
    }

    .promo-name {
      font-family: 'Inter', sans-serif;
      font-size: 16px;
      font-weight: 500;
      color: #000;
      margin-bottom: 4px;
    }

    .promo-desc {
      font-size: 14px;
      color: #5b5b5b;
      line-height: 1.5;
    }

    .site-footer {
      border-top: 1px solid rgba(0, 0, 0, 0.04);
      padding: 48px 24px;
    }

    .footer-content {
      max-width: 1440px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .footer-brand {
      font-family: 'Inter', sans-serif;
      font-size: 20px;
      font-weight: 500;
      letter-spacing: -0.01em;
      color: #000;
    }

    .footer-rule {
      width: 40px;
      height: 1px;
      background: #d0d0d0;
    }

    .footer-caption {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #999;
    }
  </style>
</body>
</html>
