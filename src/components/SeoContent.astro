---
/**
 * SEO Content Section
 * Renders keyword-rich, structured content below tool widgets.
 * This is what Google actually indexes and ranks.
 *
 * Props:
 * - toolSlug: which tool this is for
 * - modeSlug: optional mode (for multi-mode tools)
 */
interface Props {
  toolSlug: string;
  modeSlug?: string;
}

const { toolSlug, modeSlug } = Astro.props;

// Content registry — each entry is SEO text for a specific page.
// Each entry provides 500+ words of genuinely useful, unique content so the
// site satisfies Google's "substantial value" requirement for AdSense.
interface SeoEntry {
  intro: string;
  howTo?: string[];
  useCases?: string[];
  examples?: { title: string; body: string }[];
  faqs: { q: string; a: string }[];
}
const contentMap: Record<string, SeoEntry> = {
  // Calculator modes
  'calculator/mortgage': {
    intro: `This free mortgage calculator helps you estimate your monthly mortgage payments, total interest paid, and understand how a home loan amortises over its full term. Whether you are buying a first home, refinancing an existing mortgage, or comparing property financing options, knowing your likely monthly commitment before you apply is essential.

The calculation uses the standard amortisation formula. Your lender charges interest on the outstanding balance each month, and your fixed monthly payment is split between paying that interest and reducing the principal. In the early years of a 30-year mortgage the vast majority of each payment goes to interest — often 70-80% — while only a small slice reduces what you actually owe. As the balance shrinks, the split flips and progressively more of each payment goes toward the principal. This is why mortgages feel "front-loaded" and why overpaying early can save you a great deal of money in total interest over the life of the loan.

To use the calculator, enter the total amount you plan to borrow (the loan amount, excluding your deposit), your expected annual interest rate, and the loan term in years. The calculator instantly returns your monthly payment, the total you will repay, and the total interest paid. Play with the numbers — for example, reducing a 30-year mortgage to a 15-year term usually raises the monthly payment but can slash total interest by well over half.

Mortgage rates vary by country, lender, credit score, and deposit size. In the UK rates are often fixed for 2-5 years then move to a variable or tracker rate; in the US 30-year and 15-year fixed-rate mortgages are standard. Because interest compounds monthly, even a difference of 0.5 percentage points can mean tens of thousands of pounds or dollars in interest over a 30-year term. Use this calculator to stress-test different rates and terms before you talk to a lender, and always check whether the quoted rate is fixed, variable, or an introductory teaser rate.`,
    howTo: [
      'Enter the total loan amount you wish to borrow — the property price minus your deposit. For a £300,000 home with a 10% deposit, that would be £270,000.',
      'Enter your annual interest rate as a percentage. If your lender quotes 3.5%, enter 3.5. If they quote an APR that includes fees, you can use that figure to see the true cost.',
      'Enter the loan term in years — typically 25 or 30 years, though 15 and 20-year terms are common.',
      'Click the Calculate button to see your estimated monthly payment, the total amount you will repay over the term, and the total interest paid.',
      'Adjust the deposit or term to see how it changes your payment, then compare scenarios side by side before discussing options with a lender.',
    ],
    useCases: [
      'First-time buyers working out whether they can afford a property',
      'Existing homeowners comparing a 15-year vs 30-year refinance',
      'Buy-to-let investors stress-testing rental income against mortgage costs',
      'Anyone deciding whether to overpay or extend their mortgage term',
    ],
    faqs: [
      { q: 'How is mortgage interest calculated?', a: 'Mortgage interest is calculated using an amortisation formula. Each monthly payment covers the interest accrued that month plus a portion of the principal. Early payments are mostly interest; later payments are mostly principal.' },
      { q: 'What is the difference between APR and interest rate?', a: 'The interest rate is the cost of borrowing the principal. APR (Annual Percentage Rate) includes the interest rate plus other fees (origination, discount points, closing costs), giving you the true cost of the loan.' },
      { q: 'How much deposit do I need for a mortgage?', a: 'Most lenders require a minimum 5-20% deposit. A larger deposit (20%+) typically gets you better interest rates and avoids private mortgage insurance (PMI) in some markets.' },
      { q: 'Should I choose a 15 or 30-year mortgage?', a: 'A 15-year mortgage has higher monthly payments but dramatically lower total interest. A 30-year mortgage has lower monthly payments but you pay significantly more interest over time. Use this calculator to compare the totals before deciding.' },
      { q: 'How does overpaying affect my mortgage?', a: 'Overpaying reduces the principal directly, which means less interest accrues each month. Even modest overpayments in the first years can shorten the term by years and save thousands in interest.' },
      { q: 'Can I use this for a remortgage or refinance?', a: 'Yes. Enter your outstanding balance, the new rate, and the remaining term to see how refinancing at a lower rate changes your monthly payment and total interest.' },
    ],
  },
  'calculator/compound-interest': {
    intro: `This compound interest calculator shows how money grows over time when the interest you earn is reinvested and itself earns interest. Compound interest is often called the eighth wonder of the world because, given enough time, it turns modest regular savings into substantial wealth — and it works against you just as hard when you carry a high-interest balance on a loan or credit card.

The underlying maths is straightforward. Start with a principal, earn interest on it, and then earn interest on that interest. The more often interest compounds — daily, monthly, quarterly, annually — the faster your balance grows, though the difference is modest for short periods and low rates. Over decades it is the single most important factor in long-term investment growth, which is why financial advisers emphasise starting early: the earlier you start, the longer your money compounds and the more dramatic the snowball effect.

To use this calculator, enter the amount you are starting with (the principal), your expected annual rate of return, how long you will hold the investment in years, and how often the interest compounds each year. The result shows your final balance and how much of that is pure interest rather than your original principal. For example, £10,000 invested at 5% compounding monthly over 20 years grows to roughly £27,126, of which more than £17,000 is interest earned on interest.

Compound interest applies just as powerfully to debt. A credit card balance of £5,000 at 20% interest compounding daily can double in under four years if you only make minimum payments. Use this calculator both ways — to see how your savings can grow, and to understand how much costly debt can grow against you. The earlier you start, the stronger the effect, so small regular contributions made early beat larger contributions made later every time.`,
    howTo: [
      'Enter the principal — the amount you are investing or borrowing today.',
      'Enter the annual interest rate as a percentage. For a savings account paying 4%, enter 4.',
      'Enter the number of years you will hold the investment or carry the debt.',
      'Choose how often the interest compounds — daily, monthly, quarterly, semi-annually, or annually. Daily compounds the fastest.',
      'Press Calculate to see your final balance and the total interest earned.',
    ],
    useCases: [
      'Estimating how a retirement or ISA account will grow over decades',
      'Comparing savings accounts and investment products with different compounding frequencies',
      'Understanding how fast high-interest credit card debt compounds against you',
      'Modelling the effect of starting to invest 5 years earlier versus later',
    ],
    faqs: [
      { q: 'What is compound interest?', a: 'Compound interest is interest earned on both the initial principal and the accumulated interest from previous periods. Unlike simple interest, it grows exponentially over time.' },
      { q: 'How often should interest compound?', a: 'More frequent compounding yields slightly more returns. Daily compounding earns marginally more than monthly, which earns more than annual. The difference is small at low rates but significant at higher rates over long periods.' },
      { q: 'What is the compound interest formula?', a: 'A = P(1 + r/n)^(nt), where A is the final amount, P is the principal, r is the annual rate, n is compounding frequency, and t is time in years.' },
      { q: 'What is the rule of 72?', a: 'The rule of 72 is a quick mental shortcut: divide 72 by your annual rate of return to estimate how many years it takes your money to double. At 8% per year, your money doubles in roughly 9 years.' },
      { q: 'Does compound interest work against me on debt?', a: 'Yes. On credit cards and other debt, unpaid interest compounds into your balance, so your debt grows exponentially. This is why paying off high-interest debt early is so important.' },
      { q: 'Why is starting early so important?', a: 'Because compounding has an exponential curve, the bulk of your growth happens in the later years. The earlier you start, the more compounding cycles your money goes through, and the smaller the monthly amount needed to hit your goal.' },
    ],
  },
  'calculator/simple-interest': {
    intro: `This simple interest calculator works out the interest earned or owed when interest is calculated only on the original principal, never on accumulated interest. Simple interest is the transparent, predictable form of interest used for many short-term loans, some car finance deals, treasury bonds, and certificates of deposit. Unlike compound interest, it does not snowball, which makes the total interest over the term very easy to predict up front.

The formula is delightfully simple: Interest = Principal × Rate × Time. If you borrow £10,000 at 5% per year for 3 years, the interest is £10,000 × 0.05 × 3 = £1,500, and the total to repay is £11,500. There is no interest on interest, so the figures stay straightforward and can be calculated by anyone on the back of an envelope — which is precisely why simple interest is still widely used for short-term lending.

To use the calculator, enter the principal, the annual interest rate as a percentage, and the number of years, then press Calculate. It returns the total interest and the total amount you must repay or will receive. Swap in different rates and terms to see how the numbers move — for a short-term loan the difference between simple and compound interest is often negligible, but for longer terms or a revolving balance the gap becomes very large indeed.

Simple interest is common in car finance, personal loans with a fixed payoff, student loans in many countries, and savings products like certificates of deposit (CDs) where interest is paid out rather than reinvested. If you want to compare it against a compounding product, use our compound interest calculator side by side — that is often the clearest way to see why compounding is powerful over long periods and why simple interest is best reserved for short, predictable borrowing.`,
    howTo: [
      'Enter the principal — the amount borrowed or invested.',
      'Enter the annual interest rate as a percentage (e.g. 5 for 5%).',
      'Enter the term in years.',
      'Press Calculate to see the total interest and the total to repay or receive.',
    ],
    useCases: [
      'Understanding the true cost of a short-term personal or car loan',
      'Calculating interest on a fixed-term savings bond where interest is paid out',
      'Comparing simple-interest finance against compound-interest products',
      'Teachers, students, and finance learners checking their own working',
    ],
    faqs: [
      { q: 'What is the simple interest formula?', a: 'Simple Interest = P × r × t, where P is the principal, r is the annual interest rate, and t is the time in years.' },
      { q: 'Simple vs compound interest — what is the difference?', a: 'Simple interest is calculated only on the principal. Compound interest is calculated on the principal plus accumulated interest, meaning it grows faster over time. For short-term loans the difference is minimal; for long-term investments compound is significantly better.' },
      { q: 'When is simple interest used?', a: 'Simple interest is common for short-term loans, car finance, savings products where interest is paid out, and short-dated bonds. It is simpler and more transparent than compound interest.' },
      { q: 'How do I calculate monthly simple interest?', a: 'Calculate the annual simple interest, then divide by 12 for monthly. For a £10,000 loan at 5% a year, the annual interest is £500 and the monthly interest is about £41.67.' },
    ],
  },
  'calculator/vat': {
    intro: `This VAT calculator adds or removes value-added tax from any price instantly, for any rate in the world. Whether you are a business owner setting prices, an accountant preparing invoices, or a shopper trying to work out how much tax you are really paying, this tool handles both directions: adding VAT to a net price and removing VAT from a gross price.

Adding VAT is the simple direction — just multiply the net price by the rate. To add 20% VAT to a £100 net price, you add £20 and the gross price is £120. Removing VAT, also called VAT reverse calculation or extracting VAT, is the one that trips people up. To work backwards from a £120 gross price at 20% VAT, you divide by 1.20 to get £100, not subtract 20%. The VAT included is the difference, £20. The calculator does both directions for you correctly, removing the most common error.

Different countries and product categories apply different rates. The UK standard rate is 20%, with a reduced 5% for home energy and childrens car seats. Spain uses 21% standard, 10% reduced, and 4% super-reduced. Germany uses 19% standard and 7% reduced. Many goods and services such as most food, books, and childrens clothing are zero-rated or exempt. Choosing the correct rate matters because getting it wrong means incorrect invoices and potential penalties from the tax authority.

If you run a business, VAT is usually a pass-through: you collect it on sales and reclaim it on business purchases, and you remit the difference to the tax authority. If you set prices inclusive of VAT, this calculator removes VAT to show what you actually earn before tax. For a freelancer billing, for example, at €1,000 including 21% VAT, your net revenue before VAT is €826.45 and the VAT you owe is €173.55. Use this calculator to keep your margins and invoices accurate.`,
    howTo: [
      'Enter the amount you are working with — either the net price or the gross (VAT-inclusive) price.',
      'Select the VAT rate that applies: 20% UK, 21% Spain, 19% Germany, or a reduced rate as needed.',
      'Choose whether to Add VAT (net to gross) or Remove VAT (gross to net).',
      'Press Calculate to see the result, the VAT amount, and the breakdown.',
    ],
    useCases: [
      'Setting prices as a sole trader or small business so your margins are correct',
      'Preparing invoices and quotes that show VAT separately',
      'Working out how much VAT is embedded in a retail price',
      'Checking a supplier invoice for a correct amount of VAT',
    ],
    faqs: [
      { q: 'How do I calculate VAT backwards?', a: 'To remove VAT from a gross price, divide by (1 + VAT rate). For example, for 20% VAT: net price = gross ÷ 1.20. The VAT amount is gross minus net.' },
      { q: 'What is the standard VAT rate in Spain?', a: 'The standard VAT (IVA) rate in Spain is 21%. A reduced rate of 10% applies to food, transport, and hospitality. A super-reduced rate of 4% applies to basic necessities like bread, milk, and books.' },
      { q: 'What is the VAT rate in the UK?', a: 'The standard VAT rate in the UK is 20%. A reduced rate of 5% applies to some goods and services like home energy and childrens car seats. Zero-rated items include most food, books, and childrens clothing.' },
      { q: 'How do I add VAT to a net price?', a: 'Multiply the net price by the VAT rate and add that to the net price. For 20% VAT on £100: £100 × 1.20 = £120 gross.' },
      { q: 'Is VAT the same as sales tax?', a: 'Not exactly. VAT is collected at each stage of a supply chain on the value added, with businesses reclaiming input VAT. Sales tax is a single retail tax. In Europe and the UK VAT is standard; in most of the US a sales tax applies at the point of sale.' },
    ],
  },
  'calculator/percentage': {
    intro: `This percentage calculator handles the everyday percentage problems that come up constantly in shopping, finance, cooking, and data analysis — percentage of a number, percentage change, and reverse percentages. Percentages are everywhere: discounts, tips, interest rates, taxes, markups, grade scores, and statistical changes, so being able to do them correctly saves you money and avoids error.

The three most common operations are covered. To find what percent one number is of another, divide the part by the whole and multiply by 100 — 30 is 15% of 200. To find a percentage of a number, multiply the number by the percentage as a decimal — 15% of 200 is 30. To work out percentage change between two values, subtract the old from the new, divide by the old, and multiply by 100 — a price that rises from £50 to £60 is a 20% increase.

Enter the two numbers you have and the calculator works out the result and shows the working, so you can see exactly how it got there. This matters because percentages can mislead when the base changes. A 50% discount followed by a 50% markup does not bring you back to the original price — because the markup is computed on the already-discounted price, the final price is only 75% of the original. Similarly, a stock that falls 50% then rises 50% only recovers to 75% of its original value.

Use this calculator for discounts while shopping, for checking a price rise, for working out tips and taxes, for grading and statistics, and for financial analysis. When a politician or headline says "a 20% increase in cost," this tool quickly shows what that means in real numbers. Accurate percentages protect your money and your decisions.`,
    howTo: [
      'Enter the whole amount (the total you are taking a percentage of).',
      'Enter the part amount or percentage depending on which direction you want.',
      'Press Calculate to see the result — the percentage, the percentage-of, or the percentage change.',
    ],
    useCases: [
      'Shopping discounts and sales ("how much do I save at 25% off?")',
      'Restaurant tips and service charges',
      'Sales price increases, wages rises and financial returns',
      'Statistical changes in reports and news',
    ],
    faqs: [
      { q: 'How do I calculate percentage change?', a: 'Percentage change = ((new value - old value) / old value) × 100. A positive result is an increase; a negative result is a decrease.' },
      { q: 'How do I calculate a percentage of a number?', a: 'Multiply the number by the percentage divided by 100. For example, 15% of 200 = 200 × 0.15 = 30.' },
      { q: 'What is the difference between percentage and percentage points?', a: 'Percentage points refer to an absolute difference in percentages, while percentage change is relative. An increase from 10% to 12% is a 2 percentage point rise but a 20% relative increase.' },
      { q: 'How do I work out the original price before a discount?', a: 'If an item costs £60 after a 25% discount, the original price is £60 ÷ 0.75 = £80. You divide the discounted price by (1 minus the discount rate).' },
    ],
  },
  'calculator/tip': {
    intro: `This tip calculator handles the two fiddly dinner maths problems that come up constantly: how much to tip, and how to split the total fairly between a group. Enter the bill amount, pick a tip percentage, and split the bill between however many people are at the table to get a per-person amount, the tip, and the total.

Tipping is one of the most confusing travel subjects in the world because the norms differ wildly by country. In the United States and United States 15-20% is standard for sit-down restaurant service, because waitstaff are paid an hourly base that assumes tips. In the UK and most of Europe, a service charge of 10-12% is often already included in the bill, and an additional tip is optional — often rounding up or adding 5-10% for good service. In Japan tipping is not customary at all and can even be considered rude; excellent service is simply the standard. In some countries such as Australia, Australia a tip of the normal 10% is appreciated but not expected. Knowing the local norm avoids the awkwardness of tipping too much or too little.

To use the calculator, enter the bill amount, choose your tip percentage, and enter the number of diners you are splitting with. It instantly returns how much the tip is, the total including tip, and the exact amount each person owes. If you want to round each person's share to a tidy figure, simply adjust the total up slightly — nobody minds an extra fifty pence for the sake of a clean transaction.

For large groups, watch out for auto-gratuity: many restaurants automatically add 18-20% for parties of six or more, and adding an additional tip on top of that is unnecessary. Check your bill and only tip on top of the auto-gratuity if service went genuinely above and beyond. Use this calculator to keep your share fair and your maths clean.`,
    howTo: [
      'Enter the bill amount (the total cost before tip).',
      'Choose the tip percentage — 15-20% in the US, less or none in Europe and Asia as the norm requires.',
      'Enter how many people will split the bill.',
      'Press Calculate to see the tip, total, and per-person share.',
    ],
    useCases: [
      'Dining out with friends or a couple who want a fair split',
      'Deciding what tip is appropriate in an unfamiliar country',
      'Working out how much to tip a hairdresser, taxi driver, or tour guide',
      'Avoiding over-tipping when a service charge is already included',
    ],
    faqs: [
      { q: 'How much should I tip?', a: 'In the US, 15-20% is standard for sit-down restaurants. In many European countries, a service charge is already included — rounding up or 5-10% is appreciated. In Japan, tipping is not customary.' },
      { q: 'How do I split a bill with tip?', a: 'Calculate the total (bill + tip), then divide by the number of people. This calculator does that for you automatically.' },
      { q: 'What is auto-gratuity?', a: 'Auto-gratuity is a service charge some restaurants add automatically for large groups, typically 18-20% for parties of six or more. Check your bill before tipping on top.' },
      { q: 'Do I tip in Europe?', a: 'In many European countries, a service charge is already included in the bill. If not, a 5-10% tip for good service is appreciated but not expected. In Japan and much of East Asia, tipping is not customary.' },
    ],
  },
  'calculator/bmi': {
    intro: `This BMI calculator instantly works out your Body Mass Index using either metric (kilograms and centimetres) or imperial (pounds and feet/inches) units, and tells you which category your result falls into — underweight, normal weight, overweight, or obese. BMI, or Body Mass Index, is the simplest widely used tool for screening whether a person's weight is in a healthy range for their height.

BMI is calculated by dividing your weight in kilograms by the square of your height in metres. For the metric version, that is BMI = weight(kg) ÷ height(m)². For imperial users, the calculator handles the feet-and-inches to metres conversion for you and applies the 703 multiplier so you never have to worry about the maths. For most adults, a BMI of 18.5–24.9 is considered normal or healthy, under 18.5 is underweight, 25–29.9 overweight, and 30 or above obese.

BMI is a useful and convenient screening tool, but it is not a perfect measure of body fat. It does not distinguish between muscle and fat, so a muscular athlete may show a BMI in the overweight or even obese range despite having very low body fat — muscle is denser than fat, so heavier at the same height. Similarly, because it is based on overall weight, BMI can underestimate body fat in older adults who lose muscle and bone with age. It also does not account for where the fat is carried, which matters: abdominal fat (apple-shaped) is a higher health risk than fat carried around the hips and thighs.

For this reason BMI is best used as one data point among several, alongside waist circumference, body fat percentage, and blood pressure. Use this calculator to know your own number and category, then speak to a health professional about what it means for you personally. The calculator works for anyone who wants a quick, standardised picture of their weight relative to height.`,
    howTo: [
      'Choose between metric (kilograms/centimetres) and imperial (pounds/feet) units.',
      'Enter your weight and height in the units you have chosen.',
      'Press Calculate to see your BMI value and its category.',
      'Use the result as a screening data point alongside a medical consultation.',
    ],
    useCases: [
      'Quickly checking your own BMI category without the maths',
      'Tracking BMI changes over time as you adjust diet or exercise',
      'Using the metric and imperial versions interchangeably between countries',
      'Understanding where your BMI lands on the standard categories chart',
    ],
    faqs: [
      { q: 'What is BMI?', a: 'Body Mass Index (BMI) is a number calculated from your weight and height. It is a screening tool used by health professionals to categorise weight status and identify potential health risks.' },
      { q: 'How is BMI calculated?', a: 'Metric: BMI = weight (kg) ÷ height² (m). Imperial: BMI = 703 × weight (lb) ÷ height² (in). This calculator handles both formulas automatically.' },
      { q: 'What is a healthy BMI?', a: 'A healthy (normal) BMI is between 18.5 and 24.9. Below 18.5 is underweight, 25-29.9 is overweight, and 30+ is obese. These ranges apply to most adults.' },
      { q: 'Is BMI accurate for everyone?', a: 'BMI is a useful population-level screening tool but has limitations. It does not distinguish between muscle and fat, so athletes may have a high BMI without excess fat. It may also underestimate body fat in older adults.' },
      { q: 'What are the BMI categories?', a: 'Underweight is below 18.5, normal weight is 18.5–24.9, overweight is 25–29.9, and obese is 30 and above. Some systems subdivide obesity further into classes 1, 2, and 3.' },
    ],
