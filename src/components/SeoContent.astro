const key = modeSlug ? `${toolSlug}/${modeSlug}` : toolSlug;
const content = contentMap[key];

// Build a clean heading from the tool/mode name
const toolName = toolSlug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
const modeName = modeSlug ? modeSlug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) : '';
const headingName = modeName || toolName;

const faqJsonLd = content ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
