---
import Layout from '../layouts/Layout.astro';
import { toolIconSvg } from '../lib/tools';
import LongTailConverter from '../components/LongTailConverter.astro';

const title = 'miles to km Converter — Miles to Kilometres';
const description = 'Convert miles to kilometres instantly. Free miles to km calculator — 1 mile = 1.60934 km. Enter any distance to see the exact kilometres conversion.';
const canonicalPath = '/miles-to-km/';
const keywords = ['miles to km', 'miles to kilometers', 'mi to km', 'miles to kilometres', 'distance converter'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Redd Tools miles to km Converter',
  description,
  url: 'https://reddtools.com/miles-to-km/',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Unit Converter', href: '/unit-converter/length/' },
  { name: 'miles to km' },
];

const relatedTools = [
  { name: 'Length Converter', href: '/unit-converter/length/', description: 'Convert between miles, km, metres, feet, inches and more.', icon: toolIconSvg['unit-converter'] },
  { name: 'KM to Miles Converter', href: '/km-to-miles/', description: 'Convert kilometres to miles instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Feet to CM Converter', href: '/feet-to-cm/', description: 'Convert feet to centimetres instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Inches to CM Converter', href: '/inches-to-cm/', description: 'Convert inches to centimetres instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'kg to lbs Converter', href: '/kg-to-lbs/', description: 'Convert kilograms to pounds instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Celsius to Fahrenheit', href: '/celsius-to-fahrenheit/', description: 'Convert °C to °F instantly.', icon: toolIconSvg['unit-converter'] },
];
---

<Layout title={title} description={description} activeTool="unit-converter" canonicalPath={canonicalPath} keywords={keywords} jsonLd={jsonLd} breadcrumbs={breadcrumbs} relatedTools={relatedTools}>
  <LongTailConverter
    mode="length"
    fromUnit="Mile"
    toUnit="Kilometre"
    defaultValue={1}
    seoIntro={`The miles to kilometres conversion crops up constantly, whether you are checking a running route, planning a road trip, reading a weather report or converting a speed limit. The confusion is understandable, because the two units belong to different measurement families. The mile is the traditional unit of distance in the imperial system, still used for everyday road distances in the United States and the United Kingdom, while the kilometre is the metric unit used for the same job in almost every other country. For anyone who travels between these worlds, or follows sport, fitness and news from across the Atlantic, a reliable miles-to-km conversion is indispensable. It turns an unfamiliar figure into something you can instantly picture, which is why it is one of the most searched distance conversions on the internet.

The history behind the two units makes the split easy to understand. The mile descends from the Roman "mille passus", a thousand paces, and was formalised as the British imperial mile (1,760 yards, or 5,280 feet) in 1593 under Queen Elizabeth I. The kilometre, in contrast, was introduced with the metric system in France in the 1790s as exactly one thousand metres, and was deliberately designed to be an easy decimal fraction of the metre. In 1959 the international yard and pound agreement finally locked the mile to a precise metric value: exactly 1.609344 kilometres. That one constant is all you need for any conversion.

The maths is exact and never changes. To change miles into kilometres, multiply the number of miles by 1.609344; to go the other way, divide the kilometres by 1.609344 or multiply by 0.62137. For a quick reference table, remember that 1 mile = 1.61 km, 5 miles = 8.05 km, 10 miles = 16.09 km, 25 miles = 40.23 km, and 100 miles = 160.93 km. Sporting anchors help too: a 5 km parkrun is 3.11 miles, a 10 km race is 6.21 miles, a half marathon of 21.1 km is 13.1 miles, and a full 26.2-mile marathon is 42.16 km. For drivers, a 30 mph limit is about 48 km/h, 40 mph is about 64 km/h, and the 70 mph motorway limit is close to 113 km/h. Memorising a few of these everyday figures makes foreign speed signs and race distances instantly relatable.

Where does this conversion actually matter? For runners and cyclists it governs training splits, pacing and race planning across borders. For drivers and travellers it is essential when a hire car's speedometer reads in km/h while your licence and habits run on miles, or when a sat-nav quotes distances in miles inside a metric country. It also turns up in fuel-economy figures, flight distances, aviation, weather forecasts and navigation. Because the two systems divide the world's roads roughly down the middle, almost everyone who travels internationally will need this conversion at some point.

For a rough mental estimate, multiply miles by 1.6 to get kilometres — so 10 miles is about 16 km and 50 miles about 80 km. That is fine for conversation but not for careful planning, so use the full 1.609344 factor (or this converter) for pacing a race, estimating driving time or anything where accuracy matters. Enter any value below and the tool gives you the exact equivalent in kilometres instantly, in both whole numbers and decimals.`}
    faqs={[
      { q: 'How many kilometres are in a mile?', a: 'One mile is exactly 1.60934 kilometres. To convert miles to km, multiply the number of miles by 1.60934. To convert the other way, divide km by 1.60934, or multiply km by 0.6214.' },
      { q: 'How do I convert miles to km quickly in my head?', a: 'Multiply the number of miles by 1.6 for a close mental estimate. So 10 miles is about 16 km (exact: 16.09 km). For a rough number you can also think of 5 miles as roughly 8 km.' },
      { q: 'How long is a 5K run in miles?', a: 'A 5K is 5 kilometres, which is 3.107 miles. A 10K is 6.214 miles, a half marathon (21.1 km) is 13.11 miles, and a full marathon (42.2 km) is 26.22 miles.' },
      { q: 'What is 60 mph in km/h?', a: '60 mph is exactly 96.56 km/h. To convert any speed from mph to km/h, multiply by 1.60934 — so 70 mph is about 112.7 km/h, a common motorway limit.' },
      { q: 'How many miles is 100 km?', a: '100 km is 62.14 miles. This is a handy reference for anyone driving in a metric country who wants to understand distances in miles — 100 km is roughly a 62-mile journey.' },
      { q: 'Is a mile or a kilometre longer?', a: 'A mile is the longer unit, equal to about 1.61 km. That means distances in miles will always be smaller numbers than the same distance expressed in kilometres.' },
      { q: 'How many kilometres are there in a marathon?', a: 'A standard marathon is 26.2 miles, which is exactly 42.20 km. The half marathon is 13.1 miles, about 21.10 km.' },
      { q: 'Why do the US and UK use miles while other countries use kilometres?', a: 'Road distances and speed limits in the US are measured in miles because it uses the imperial system, and the UK still uses miles for road signs. Most other countries adopted the metric kilometre for all road distances decades ago.' },
      { q: 'How do I convert km back to miles?', a: 'To convert kilometres to miles, multiply the kilometres by 0.6214. For example, 100 km multiplied by 0.6214 equals 62.14 miles. A simple mental shortcut is to multiply km by 5 and divide by 8.' },
      { q: 'How accurate is this miles to kilometres converter?', a: 'The converter uses the exact factor of 1.609344 km per mile, so results are correct to several decimal places — far more precise than a rough estimate, and ideal for running, driving and travel planning.' },
    ]}
  />
</Layout>
