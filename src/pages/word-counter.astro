---
import Layout from '../layouts/Layout.astro';
import { getTool, toolIconSvg } from '../lib/tools';
import SeoContent from '../components/SeoContent.astro';

const tool = getTool('word-counter')!;
const title = tool.seoTitle || tool.name;
const description = tool.seoDescription || tool.description;
const canonicalPath = `/${tool.slug}/`;
const keywords = tool.keywords;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Redd Tools Word Counter',
  description: tool.description,
  url: `https://reddtools.com/${tool.slug}`,
  applicationCategory: 'TextProcessingApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: tool.name },
];

// Contextual related tools
const relatedTools = [
  { name: 'Case Converter', href: '/case-converter/', description: 'Convert text between uppercase, lowercase, title case, camelCase and more.', icon: toolIconSvg['case-converter'] },
  { name: 'Timer & Pomodoro', href: '/timer/', description: 'Countdown timer, stopwatch, and pomodoro timer with tab-title countdown.', icon: toolIconSvg['timer'] },
  { name: 'Image Colour Picker', href: '/colour-picker/', description: 'Drop an image and pick exact pixel colours. Get HEX, RGB, and HSL values instantly.', icon: toolIconSvg['colour-picker'] },
];
---

<Layout title={title} description={description} activeTool="word-counter" canonicalPath={canonicalPath} keywords={keywords} jsonLd={jsonLd} breadcrumbs={breadcrumbs} relatedTools={relatedTools}>
  <div class="max-w-2xl mx-auto">
    <div class="calc-card">
      <h1>Word Counter</h1>

      <textarea id="wc-input" placeholder="Start typing or paste your text here..." rows="10"></textarea>

      <div class="stats-grid">
        <div class="stat-box">
          <div class="stat-label">Words</div>
          <div class="stat-value" id="stat-words">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Characters</div>
          <div class="stat-value" id="stat-chars">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Sentences</div>
          <div class="stat-value" id="stat-sentences">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Paragraphs</div>
          <div class="stat-value" id="stat-paragraphs">0</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Reading time</div>
          <div class="stat-value" id="stat-reading">0s</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">Avg word length</div>
          <div class="stat-value" id="stat-avglen">0</div>
        </div>
      </div>

      <div class="actions">
        <button class="btn btn-primary" id="copy-stats" onclick="copyStats()">
          📋 Copy Stats
        </button>
        <button class="btn btn-secondary" id="copy-text" onclick="copyText()">
          📄 Copy Text
        </button>
        <button class="btn btn-secondary" id="clear-text" onclick="clearText()">
          🗑️ Clear
        </button>
      </div>
    </div>

    <div id="toast" class="toast"></div>

    <SeoContent toolSlug="word-counter" />
  </div>
</Layout>

<script>
  const input = document.getElementById('wc-input') as HTMLTextAreaElement;
  const toast = document.getElementById('toast') as HTMLDivElement;

  function update() {
    const text = input.value;
    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
    const chars = text.length;
    const sentences = text.trim() ? (text.match(/[.!?]+(?:\s|$)/g) || []).length || (words > 0 ? 1 : 0) : 0;
    const paragraphs = text.trim() ? text.split(/\n\s*\n/).filter((p) => p.trim().length > 0).length : 0;
    const readingSeconds = Math.round(words / 200 * 60);
    const avgLen = words > 0 ? (text.replace(/\s/g, '').length / words).toFixed(1) : '0';

    document.getElementById('stat-words')!.textContent = words.toLocaleString();
    document.getElementById('stat-chars')!.textContent = chars.toLocaleString();
    document.getElementById('stat-sentences')!.textContent = sentences.toLocaleString();
    document.getElementById('stat-paragraphs')!.textContent = paragraphs.toLocaleString();

    let rt: string;
    if (readingSeconds < 60) rt = readingSeconds + 's';
    else rt = Math.floor(readingSeconds / 60) + 'm ' + (readingSeconds % 60) + 's';
    document.getElementById('stat-reading')!.textContent = rt;

    document.getElementById('stat-avglen')!.textContent = avgLen;

    if (typeof (window as any).posthog !== 'undefined' && words > 0) {
      (window as any).posthog.capture('word_counter_used', { words, chars, sentences });
      (window as any).posthog.capture('tool_used', { tool: 'word-counter', words, chars, sentences });
    }
  }

  function showToast(message: string) {
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
    }, 2000);
  }

  function copyStats() {
    const words = document.getElementById('stat-words')!.textContent;
    const chars = document.getElementById('stat-chars')!.textContent;
    const sentences = document.getElementById('stat-sentences')!.textContent;
    const paragraphs = document.getElementById('stat-paragraphs')!.textContent;
    const reading = document.getElementById('stat-reading')!.textContent;
    const avgLen = document.getElementById('stat-avglen')!.textContent;

    const stats = `Word Count: ${words}\nCharacter Count: ${chars}\nSentence Count: ${sentences}\nParagraph Count: ${paragraphs}\nReading Time: ${reading}\nAvg Word Length: ${avgLen}`;

    navigator.clipboard.writeText(stats).then(() => {
      showToast('Stats copied to clipboard!');
    }).catch(() => {
      showToast('Failed to copy stats');
    });
  }

  function copyText() {
    const text = input.value;
    if (!text) {
      showToast('No text to copy');
      return;
    }
    navigator.clipboard.writeText(text).then(() => {
      showToast('Text copied to clipboard!');
    }).catch(() => {
      showToast('Failed to copy text');
    });
  }

  function clearText() {
    input.value = '';
    update();
    input.focus();
    showToast('Text cleared');
  }

  input.addEventListener('input', update);
</script>

<style>
  .calc-card {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    padding: 24px;
  }

  .calc-card h1 {
    font-family: 'Inter', sans-serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
    color: #000;
    margin: 0 0 24px;
  }

  .calc-desc {
    font-size: 14px;
    color: #5b5b5b;
    margin: 0 0 24px;
  }

  #wc-input {
    width: 100%;
    padding: 12px 16px;
    background: #fafafa;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: #000;
    resize: vertical;
    min-height: 200px;
    box-sizing: border-box;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  #wc-input:focus {
    outline: none;
    border-color: #00c2ff;
    box-shadow: 0 0 0 3px rgba(0, 194, 255, 0.1);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 20px;
  }

  @media (max-width: 480px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .stat-box {
    padding: 16px;
    background: #fafafa;
    border: 1px solid rgba(0, 0, 0, 0.04);
    border-radius: 4px;
  }

  .stat-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #999;
  }

  .stat-value {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 24px;
    font-weight: 400;
    color: #000;
    margin-top: 4px;
  }

  .seo-content {
    margin-top: 32px;
    padding: 24px;
    color: #5b5b5b;
  }

  .seo-content h2 {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 500;
    color: #000;
    margin: 0 0 8px;
  }

  .seo-content p {
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }

  .actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 200ms ease;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .btn-primary {
    background: #00c2ff;
    color: #fff;
  }

  .btn-primary:hover {
    background: #00a8e0;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: #fafafa;
    color: #000;
    border: 1px solid #d0d0d0;
  }

  .btn-secondary:hover {
    background: #f0f0f0;
  }

  .toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: #333;
    color: #fff;
    padding: 12px 24px;
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    opacity: 0;
    transition: all 300ms ease;
    z-index: 1000;
    pointer-events: none;
  }

  .toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  @media (max-width: 480px) {
    .actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>