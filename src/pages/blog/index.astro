---
import Layout from '../../layouts/Layout.astro';

const title = 'ReddTools Blog — Guides, Tips & How-Tos';
const description = 'In-depth guides and tutorials on colour theory, unit conversion, mortgage calculations, productivity techniques, and more. Free articles from the ReddTools team.';
const canonicalPath = '/blog/';

const articles = [
  {
    slug: 'colour-theory-web-design',
    title: 'Understanding Colour Theory for Web Designers and Developers',
    excerpt: 'A practical guide to the colour wheel, complementary colours, analogous palettes, and how to apply colour theory principles to build accessible, beautiful web interfaces.',
    date: '2026-08-20',
    readTime: '8 min read',
  },
  {
    slug: 'choose-brand-colour-palette',
    title: 'How to Choose the Right Colour Palette for Your Brand',
    excerpt: 'Colour is the first thing people notice about your brand. Learn a systematic process for selecting brand colours that communicate the right message and work across digital and print.',
    date: '2026-08-20',
    readTime: '7 min read',
  },
  {
    slug: 'unit-conversion-mistakes',
    title: 'Unit Conversion Mistakes to Avoid in Engineering and Science',
    excerpt: 'Unit conversion errors have crashed spacecraft, collapsed buildings, and killed patients. Learn the most common mistakes and how to prevent them using reliable tools and verification techniques.',
    date: '2026-08-20',
    readTime: '9 min read',
  },
  {
    slug: 'science-behind-bmi',
    title: 'The Science Behind BMI: What It Measures and What It Misses',
    excerpt: 'Body Mass Index is the most widely used health metric in the world. Understand how it is calculated, why it works for populations but not always for individuals, and what alternatives exist.',
    date: '2026-08-20',
    readTime: '8 min read',
  },
  {
    slug: 'mortgage-calculators-explained',
    title: 'Mortgage Calculators Explained: How Lenders Actually Compute Your Payments',
    excerpt: 'Ever wondered how banks calculate your monthly mortgage payment? We break down amortisation schedules, interest compounding, and the formulas lenders use behind the scenes.',
    date: '2026-08-20',
    readTime: '10 min read',
  },
  {
    slug: 'compound-interest-explained',
    title: 'Compound Interest: The Eighth Wonder of the World Explained Simply',
    excerpt: 'Albert Einstein allegedly called compound interest the eighth wonder of the world. Learn how it works, why it matters for savings and investments, and how to calculate it accurately.',
    date: '2026-08-20',
    readTime: '7 min read',
  },
  {
    slug: 'text-case-conventions-developers',
    title: 'Text Case Conventions Every Developer Should Know',
    excerpt: 'camelCase, snake_case, kebab-case, PascalCase — when should you use each? A comprehensive guide to naming conventions in programming, APIs, filenames, and databases.',
    date: '2026-08-20',
    readTime: '6 min read',
  },
  {
    slug: 'pomodoro-technique-guide',
    title: 'The Pomodoro Technique: A Practical Guide to Focused Work',
    excerpt: 'Struggling with distractions and procrastination? The Pomodoro Technique is a time-management method used by millions of professionals. Learn how to implement it and adapt it to your workflow.',
    date: '2026-08-20',
    readTime: '7 min read',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'ReddTools Blog',
  url: 'https://reddtools.com/blog/',
  description: 'Guides and tutorials on colour theory, unit conversion, calculations, and productivity.',
};
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <div class="blog-page">
    <div class="blog-hero">
      <h1>ReddTools Blog</h1>
      <p class="lead">In-depth guides, tutorials, and explainers on the topics our tools cover. No fluff, no paywall.</p>
    </div>

    <div class="articles-grid">
      {articles.map((article) => (
        <a href={`/blog/${article.slug}/`} class="article-card">
          <div class="article-meta">
            <span class="article-date">{article.date}</span>
            <span class="article-separator">·</span>
            <span class="article-readtime">{article.readTime}</span>
          </div>
          <h2 class="article-title">{article.title}</h2>
          <p class="article-excerpt">{article.excerpt}</p>
          <span class="article-link">Read article →</span>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .blog-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 80px 24px 120px;
  }

  .blog-hero {
    margin-bottom: 64px;
  }

  .blog-hero h1 {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #000;
    margin: 0 0 16px;
  }

  .lead {
    font-size: 20px;
    font-weight: 400;
    line-height: 1.5;
    color: #5b5b5b;
    margin: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .article-card {
    display: block;
    padding: 32px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    text-decoration: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .article-card:hover {
    border-color: rgba(0, 0, 0, 0.15);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #999;
  }

  .article-separator {
    opacity: 0.5;
  }

  .article-title {
    font-family: 'Inter', sans-serif;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    color: #000;
    margin: 0 0 12px;
    transition: color 200ms ease;
  }

  .article-card:hover .article-title {
    color: rgba(0, 0, 0, 0.7);
  }

  .article-excerpt {
    font-size: 15px;
    line-height: 1.6;
    color: #5b5b5b;
    margin: 0 0 16px;
  }

  .article-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    color: #000;
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.15);
    padding-bottom: 2px;
  }
</style>
