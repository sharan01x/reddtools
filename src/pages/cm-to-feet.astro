---
import Layout from '../layouts/Layout.astro';
import { toolIconSvg } from '../lib/tools';
import LongTailConverter from '../components/LongTailConverter.astro';

const title = 'CM to Feet Converter — Centimetres to Feet';
const description = 'Convert centimetres to feet instantly. Free cm to feet calculator — 1 cm = 0.0328 ft. Enter any length to see the exact feet conversion.';
const canonicalPath = '/cm-to-feet';
const keywords = ['cm to feet', 'centimetres to feet', 'cm to ft', 'height converter cm to feet', 'length converter'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Redd Tools CM to Feet Converter',
  description,
  url: 'https://reddtools.com/cm-to-feet',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Unit Converter', href: '/unit-converter/length' },
  { name: 'cm to feet' },
];

const relatedTools = [
  { name: 'Length Converter', href: '/unit-converter/length', description: 'Convert between feet, cm, metres, inches, miles, km and more.', icon: toolIconSvg['unit-converter'] },
  { name: 'Feet to CM Converter', href: '/feet-to-cm', description: 'Convert feet to centimetres instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Inches to CM Converter', href: '/inches-to-cm', description: 'Convert inches to centimetres instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Metres to Feet Converter', href: '/metres-to-feet', description: 'Convert metres to feet instantly.', icon: toolIconSvg['unit-converter'] },
];
---

<Layout title={title} description={description} activeTool="unit-converter" canonicalPath={canonicalPath} keywords={keywords} jsonLd={jsonLd} breadcrumbs={breadcrumbs} relatedTools={relatedTools}>
  <LongTailConverter
    mode="length"
    fromUnit="Centimetre"
    toUnit="Foot"
    defaultValue={100}
    seoIntro={`Converting centimetres to feet is one of the most practical length conversions you can make, because it sits at the heart of a very human measurement: height. Around the world, height is recorded in two ways. Much of the world uses centimetres and metres, while the United States, the UK and a handful of other countries describe people's height in feet and inches. When you fill out a form, read a sports profile, buy clothing or furniture, or talk to someone from a country that uses the other system, you will need a reliable cm to feet figure. This free tool provides it instantly.

The two units come from different traditions. The foot, which has been used for thousands of years — the Romans standardised it and its name literally describes the length of a human foot — was fixed as exactly 0.3048 metres by the international yard and pound agreement of 1959. The centimetre, by contrast, is a clean metric fraction: one hundredth of a metre, introduced with the metric system in France in the 1790s and now used worldwide for measuring length and height. Because one foot equals 30.48 centimetres, the conversion between them is precise and never changes.

The maths is simple. To convert centimetres to feet, divide the number of centimetres by 30.48; to go the other way, multiply feet by 30.48. For a useful reference table, remember that 1 cm = 0.033 ft, 50 cm = 1.64 ft, 100 cm = 3.28 ft, 150 cm = 4.92 ft, 170 cm = 5.58 ft, 180 cm = 5.91 ft, and 200 cm = 6.56 ft. These last few are the ones that matter most for human height: 170 cm is roughly 5 foot 7, 175 cm is 5 foot 9, and 180 cm is just under 5 foot 11. Because most people think of height in whole feet plus inches, it often helps to split the result — so 175 cm divides by 30.48 to give 5.74 feet, which is 5 feet and 8.9 inches.

Where does this conversion come up in real life? Height is the biggest single use: filling in medical and government forms, reading a basketball player's profile, comparing your height with friends abroad, or choosing a bicycle frame. It also matters for interior design and furniture — a 100 cm chair is about 3 feet 3 inches tall, and a standard door height of 200 cm is 6 feet 7 inches. In construction, textiles and sport, measurements frequently jump between centimetres and feet, from curtain lengths to table heights to sports equipment. Retailers who sell products measured in centimetres to customers used to feet need a reliable conversion to avoid costly mistakes.

For a rough mental estimate, remember that 30 cm is almost exactly one foot, so you can quickly picture roughly how many feet a length is by dividing the centimetres by 30. When precision matters, however — for medical height records, furniture fit, or anything where a few centimetres change the outcome — use the exact factor of 30.48 or enter the value in the converter below for an exact answer in feet every time.`}
    faqs={[
      { q: 'How many feet are in a centimetre?', a: 'One centimetre equals 0.0328084 feet, or about 0.3937 inches. To convert centimetres to feet, divide by 30.48. To convert feet to centimetres, multiply by 30.48.' },
      { q: 'How tall is 170 cm in feet?', a: '170 cm is 5.58 feet, which is exactly 5 feet 7 inches. This is a common height for adults in many metric-using countries.' },
      { q: 'How tall is 180 cm in feet?', a: '180 cm is 5.91 feet, which is about 5 feet 11 inches. It is a very frequently searched height conversion because it is a common adult height.' },
      { q: 'How tall is 175 cm in feet and inches?', a: '175 cm is 5.74 feet, which is 5 feet and 9 inches. This is another extremely common adult height reference.' },
      { q: 'How do I convert cm to feet and inches?', a: 'Divide the centimetres by 2.54 to get the total inches, then divide by 12 to get feet; the remainder is the inches. For example, 175 cm ÷ 2.54 = 68.9 inches = 5 feet 9 inches.' },
      { q: 'How many cm is 6 feet?', a: '6 feet is exactly 182.88 cm. This is a very common height reference in the UK and US, around the top of the average adult male range.' },
      { q: 'What is 160 cm in feet?', a: '160 cm is 5.25 feet, which is 5 feet 3 inches. It is a common height for women in metric-using countries and a frequently searched figure.' },
      { q: 'Is 1 foot the same as 30 cm?', a: 'Almost — 1 foot is exactly 30.48 cm, so slightly more than 30 cm. The "1 foot ≈ 30 cm" rule is a convenient approximation accurate enough for everyday estimates.' },
      { q: 'Why do some countries use feet while others use centimetres?', a: 'The US and, for many everyday purposes, the UK still measure height and length in feet and inches from the imperial system, while most other countries use the metric centimetre. The international agreement of 1959 fixed 1 foot = 30.48 cm so the two can be converted exactly.' },
      { q: 'How accurate is this cm to feet converter?', a: 'The converter uses the exact factor of 1 foot = 30.48 cm, giving results accurate to several decimal places — more than enough for height, furniture, sport and construction.' },
    ]}
  />
</Layout>
