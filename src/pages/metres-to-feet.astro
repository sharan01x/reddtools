---
import Layout from '../layouts/Layout.astro';
import { toolIconSvg } from '../lib/tools';
import LongTailConverter from '../components/LongTailConverter.astro';

const title = 'Metres to Feet Converter — Meters to Feet';
const description = 'Convert metres to feet instantly. Free metres to feet calculator — 1 metre = 3.28084 ft. Enter any length to see the exact feet conversion.';
const canonicalPath = '/metres-to-feet';
const keywords = ['metres to feet', 'meters to feet', 'm to ft', 'metre to foot', 'length converter'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Redd Tools Metres to Feet Converter',
  description,
  url: 'https://reddtools.com/metres-to-feet',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Unit Converter', href: '/unit-converter/length' },
  { name: 'metres to feet' },
];

const relatedTools = [
  { name: 'Length Converter', href: '/unit-converter/length', description: 'Convert between metres, feet, cm, inches, miles, km and more.', icon: toolIconSvg['unit-converter'] },
  { name: 'CM to Feet Converter', href: '/cm-to-feet', description: 'Convert centimetres to feet instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Feet to CM Converter', href: '/feet-to-cm', description: 'Convert feet to centimetres instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Miles to KM Converter', href: '/miles-to-km', description: 'Convert miles to kilometres instantly.', icon: toolIconSvg['unit-converter'] },
];
---

<Layout title={title} description={description} activeTool="unit-converter" canonicalPath={canonicalPath} keywords={keywords} jsonLd={jsonLd} breadcrumbs={breadcrumbs} relatedTools={relatedTools}>
  <LongTailConverter
    mode="length"
    fromUnit="Metre"
    toUnit="Foot"
    defaultValue={1}
    seoIntro={`Convert metres to feet with this free online tool. The metres to feet conversion is widely used in construction, real estate, and everyday measurements — most of the world uses metres while the US and UK often use feet. The formula is simple: 1 metre equals 3.28084 feet. To convert metres to feet, multiply the number of metres by 3.28084. For example, 2 metres = 6.56 ft, 5 metres = 16.40 ft, and 10 metres = 32.81 ft. This calculator works both ways — enter any length in metres and it instantly shows the exact equivalent in feet.`}
    faqs={[
      { q: 'How many feet in a metre?', a: '1 metre = 3.28084 feet exactly. To convert metres to feet, multiply by 3.28084. To convert feet to metres, divide by 3.28084 (or multiply by 0.3048).' },
      { q: 'How tall is 1.8 metres in feet?', a: '1.8 metres = 5.91 feet (exactly 5 feet 10.9 inches). This is a common height reference in many countries.' },
      { q: 'How many feet is 3 metres?', a: '3 metres = 9.84 feet. This is roughly the length of a small car or a standard room ceiling height.' },
      { q: 'How do I estimate metres to feet quickly?', a: 'Multiply the metres value by 3.28 for a close estimate. So 2 m ≈ 6.56 ft. For a rough mental calculation, multiply by 3 and add 10%.' },
    ]}
  />
</Layout>
