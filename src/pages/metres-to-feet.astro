---
import Layout from '../layouts/Layout.astro';
import { toolIconSvg } from '../lib/tools';
import LongTailConverter from '../components/LongTailConverter.astro';

const title = 'Metres to Feet Converter — Meters to Feet';
const description = 'Convert metres to feet instantly. Free metres to feet calculator — 1 metre = 3.28084 ft. Enter any length to see the exact feet conversion.';
const canonicalPath = '/metres-to-feet/';
const keywords = ['metres to feet', 'meters to feet', 'm to ft', 'metre to foot', 'length converter'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Redd Tools Metres to Feet Converter',
  description,
  url: 'https://reddtools.com/metres-to-feet/',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Unit Converter', href: '/unit-converter/length/' },
  { name: 'metres to feet' },
];

const relatedTools = [
  { name: 'Length Converter', href: '/unit-converter/length/', description: 'Convert between metres, feet, cm, inches, miles, km and more.', icon: toolIconSvg['unit-converter'] },
  { name: 'CM to Feet Converter', href: '/cm-to-feet/', description: 'Convert centimetres to feet instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Feet to CM Converter', href: '/feet-to-cm/', description: 'Convert feet to centimetres instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Miles to KM Converter', href: '/miles-to-km/', description: 'Convert miles to kilometres instantly.', icon: toolIconSvg['unit-converter'] },
];
---

<Layout title={title} description={description} activeTool="unit-converter" canonicalPath={canonicalPath} keywords={keywords} jsonLd={jsonLd} breadcrumbs={breadcrumbs} relatedTools={relatedTools}>
  <LongTailConverter
    mode="length"
    fromUnit="Metre"
    toUnit="Foot"
    defaultValue={1}
    seoIntro={`Converting between metres and feet is one of the most common length conversions people face, and it is surprisingly easy to get right once you know the rule. The two units belong to different measurement systems: the metre is the standard unit of length in the metric system used by the vast majority of the world, while the foot is the everyday unit in the imperial and US customary systems still used across the United States and, to a lesser extent, in the United Kingdom. That is why property listings, building plans, sports records and DIY guides so often need a quick metres-to-feet translation. Whether you are reading a European floor plan, checking the dimensions of a piece of furniture bought from abroad, or simply trying to picture how tall something is, the ability to switch comfortably between the two units saves time and prevents costly mistakes.

The relationship between the two is fixed and precise: one metre equals exactly 3.28084 feet, or 3 feet and 3.37 inches. To convert a length from metres to feet, you simply multiply the number of metres by 3.28084. The reverse is equally straightforward — divide the number of feet by 3.28084, or multiply by 0.3048, to get back to metres. So 1 metre is about 3.28 feet, 2 metres is 6.56 feet, 5 metres is 16.40 feet, and 10 metres is 32.81 feet. A standard ceiling height of 2.4 metres is close to 7.9 feet, the length of a compact car at about 4 metres is roughly 13.1 feet, and a 100-metre sprint track is just over 328 feet. Familiar reference points like these help you judge new measurements quickly, without reaching for a calculator every time.

This converter handles the whole process for you: type or slide any value in metres, or in feet, and the equivalent in the other unit appears instantly, with no manual arithmetic required. It is accurate to several decimal places, which matters when you are working on a precise project rather than a rough estimate. For everyday purposes you can get a good mental approximation by multiplying metres by 3.3, but for measurements that will be cut, installed, fitted or measured on site, you should always rely on the full conversion factor rather than a shortcut.

Whether you are converting a room dimension, a bed size, a jump height, a ceiling clearance or a furniture dimension, this tool removes the guesswork. It works in both directions, so it is equally useful whether you are reading a European floor plan drawn up in metres or a US product sheet written in feet. For property buyers, interior designers, DIY enthusiasts, athletes and travellers alike, a dependable metres-to-feet conversion is one of those small tools that quietly saves time every single week.`}
    faqs={[
      { q: 'How many feet are there in a metre?', a: 'One metre is exactly 3.28084 feet. To convert metres to feet, multiply the metre value by 3.28084. To work back from feet to metres, divide by 3.28084, or multiply the feet value by 0.3048.' },
      { q: 'How tall is 1.8 metres in feet?', a: '1.8 metres is 5.91 feet, which works out to 5 feet 11 inches. It is a very common adult height in countries that use metres.' },
      { q: 'How many feet is 3 metres?', a: '3 metres is exactly 9.84 feet. That is roughly the height of a standard domestic room ceiling, so it is a useful reference for interior planning.' },
      { q: 'What is 2 metres in feet and inches?', a: '2 metres is 6.56 feet, which is 6 feet 6.74 inches. This is close to the height of a standard interior door frame (around 6 feet 8 inches).' },
      { q: 'How do I convert metres to feet without a calculator?', a: 'Multiply the metres value by 3.28 for a close estimate — 2 m is about 6.56 ft. An even rougher mental shortcut is to multiply by 3 and add 10%, so 5 m becomes 15 plus 1.5, around 16.5 ft.' },
      { q: 'Is 1 metre longer than 1 foot?', a: 'Yes — a metre is about 3.28 times longer than a foot. A single metre is roughly the height of a kitchen worktop off the floor, while a foot is just under one third of that.' },
      { q: 'How many metres in 6 feet?', a: '6 feet is 1.83 metres. To convert feet to metres, multiply by 0.3048 (6 × 0.3048 = 1.83 m). This is a common height reference for people and for table heights.' },
      { q: 'Where are feet still used instead of metres?', a: 'Feet are the standard in the United States for most everyday lengths, and they remain common in the United Kingdom for human height and property dimensions. Most other countries use metres for all everyday measurements.' },
      { q: 'What is the difference between a metre and a meter?', a: 'Metre and meter are two spellings of the same unit — metre is the standard British and international spelling, while meter is the US spelling. The measurement is identical in both cases.' },
      { q: 'How accurate is this metres to feet converter?', a: 'The converter uses the exact international factor of 3.28084 feet per metre, so results are accurate to several decimal places. That is more than sufficient for construction, DIY, design and personal measurement.' },
    ]}
  />
</Layout>
