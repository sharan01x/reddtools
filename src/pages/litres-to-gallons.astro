---
import Layout from '../layouts/Layout.astro';
import { toolIconSvg } from '../lib/tools';
import LongTailConverter from '../components/LongTailConverter.astro';

const title = 'Litres to Gallons Converter — L to Gal';
const description = 'Convert litres to gallons instantly. Free litres to gallons calculator — 1 litre = 0.264172 US gallons. Enter any volume to see the exact gallons conversion.';
const canonicalPath = '/litres-to-gallons';
const keywords = ['litres to gallons', 'liters to gallons', 'l to gal', 'litre to gallon', 'volume converter'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Redd Tools Litres to Gallons Converter',
  description,
  url: 'https://reddtools.com/litres-to-gallons',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Unit Converter', href: '/unit-converter/volume' },
  { name: 'litres to gallons' },
];

const relatedTools = [
  { name: 'Volume Converter', href: '/unit-converter/volume', description: 'Convert between litres, gallons, cups, tablespoons, teaspoons and more.', icon: toolIconSvg['unit-converter'] },
  { name: 'Weight Converter', href: '/unit-converter/weight', description: 'Convert between kg, lbs, grams, ounces and more.', icon: toolIconSvg['unit-converter'] },
  { name: 'Length Converter', href: '/unit-converter/length', description: 'Convert between metres, feet, inches, miles and more.', icon: toolIconSvg['unit-converter'] },
  { name: 'Temperature Converter', href: '/unit-converter/temperature', description: 'Convert between Celsius, Fahrenheit and Kelvin.', icon: toolIconSvg['unit-converter'] },
];
---

<Layout title={title} description={description} activeTool="unit-converter" canonicalPath={canonicalPath} keywords={keywords} jsonLd={jsonLd} breadcrumbs={breadcrumbs} relatedTools={relatedTools}>
  <LongTailConverter
    mode="volume"
    fromUnit="Litre"
    toUnit="Gallon (US)"
    defaultValue={1}
    seoIntro={`Litres and gallons are two of the most confusing volume units you will meet, largely because there is not one gallon but two. Americans use the US gallon while Britons use the imperial (UK) gallon, and they are different sizes — so any litre to gallon conversion needs to be careful about which one you actually want. This is exactly the kind of thing that catches people out when they are filling a car in a hire vehicle, working out how much homebrew to bottle, measuring fuel for a generator, or trying to follow a recipe that was written across the Atlantic.

Let us pin down the numbers. This page converts litres to US gallons, using the factor 1 litre = 0.264172 US gallons. To convert litres to US gallons, multiply the number of litres by 0.264172. So 1 litre is 0.264 US gallons, 5 litres is 1.321 US gallons, and a standard 50-litre car fuel tank holds about 13.21 US gallons. For UK gallons the figure is different: 1 litre = 0.219969 imperial gallons, because a UK gallon is larger at 4.54609 litres compared with the US gallon's 3.78541 litres. In practice this means a UK gallon is roughly 1.2 US gallons. To reverse any of it, divide by the same factor — so a US gallon is 3.78541 litres and a UK gallon is 4.54609 litres.

Where does this matter in real life? Fuel is the headline. Petrol and diesel are sold by the litre in the UK, but car owners in North America think in gallons, and comparing prices across countries is impossible without converting. Cooking and brewing are close behind: many American recipes and larger brewing volumes are measured in gallons, while UK homebrewers and commercial kits use litres. Aquarium keepers, gardeners mixing plant feed, and anyone filling a water butt or sprayer all bounce between the two units. Knowing that a gallon is somewhere between 3.8 and 4.5 litres depending on which system you mean prevents a genuinely soggy or badly mixed batch.

The single biggest mistake people make is using the wrong gallon. The imperial gallon, based on the volume of 10 pounds of water at a fixed temperature, is about 20% larger than its US cousin, so treating them as interchangeable can throw a recipe or a fuel budget off significantly. It is always worth confirming whether you need US or UK gallons before you convert. A couple of everyday anchors help too: a standard bathtub holds around 150 litres, which is about 40 US gallons, while a 1-litre bottle of water is a shade over a quarter of a US gallon. When comparing fuel economy, British figures are given in miles per gallon using imperial gallons, whereas American figures use US gallons, so the same car can look dramatically different in economy on paper. This free tool handles US gallons precisely both ways, and the FAQs below cover the imperial conversion too, so you can be confident your volumes are correct whichever side of the pond you are on.`}
    faqs={[
      { q: 'How many US gallons are in a litre?', a: '1 litre = 0.264172 US gallons. To convert litres to US gallons, multiply by 0.264172. To convert US gallons to litres, multiply by 3.78541.' },
      { q: 'How many UK gallons are in a litre?', a: '1 litre = 0.219969 UK (imperial) gallons. The UK gallon is larger than the US gallon, so a litre makes fewer UK gallons.' },
      { q: 'How many litres are in a gallon?', a: '1 US gallon = 3.78541 litres, while 1 UK (imperial) gallon = 4.54609 litres. Always check which gallon you are using.' },
      { q: 'What is 50 litres in gallons?', a: '50 litres = 13.21 US gallons, or 11.0 UK gallons. This is a common fuel tank capacity reference.' },
      { q: 'Why is there a US gallon and a UK gallon?', a: 'The US gallon evolved from the older wine gallon, while the UK gallon is the imperial gallon defined by the volume of 10 pounds of water. They differ by about 20%.' },
      { q: 'How many litres does a typical car fuel tank hold?', a: 'A typical car fuel tank holds around 45–60 litres, which is about 12–16 US gallons or 10–13 UK gallons.' },
      { q: 'What is 5 litres in gallons?', a: '5 litres = 1.321 US gallons, or 1.10 UK gallons. This is a common container size for oil, water and homebrew.' },
      { q: 'How do I convert gallons to litres?', a: 'For US gallons, multiply by 3.78541. For UK gallons, multiply by 4.54609. So 5 US gallons = 18.93 litres.' },
      { q: 'How many gallons is 20 litres of water?', a: '20 litres = 5.28 US gallons, or 4.40 UK gallons. Useful when measuring buckets, aquariums and watering cans.' },
      { q: 'What is a common mistake when converting litres to gallons?', a: 'Using the wrong gallon. The US and UK gallons differ by about 20%, so mixing them up can badly misjudge a recipe, a fuel purchase or a brew.' },
    ]}
  />
</Layout>
