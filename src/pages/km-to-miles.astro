---
import Layout from '../layouts/Layout.astro';
import { toolIconSvg } from '../lib/tools';
import LongTailConverter from '../components/LongTailConverter.astro';

const title = 'KM to Miles Converter — Kilometres to Miles';
const description = 'Convert kilometres to miles instantly. Free km to miles calculator — 1 km = 0.621371 miles. Enter any distance to see the exact mile value.';
const canonicalPath = '/km-to-miles/';
const keywords = ['km to miles', 'kilometers to miles', 'km to mi', 'kilometres to miles', 'distance converter'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Redd Tools KM to Miles Converter',
  description,
  url: 'https://reddtools.com/km-to-miles/',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Unit Converter', href: '/unit-converter/length/' },
  { name: 'KM to Miles' },
];

const relatedTools = [
  { name: 'Length Converter', href: '/unit-converter/length/', description: 'Convert between km, miles, metres, feet, inches and more.', icon: toolIconSvg['unit-converter'] },
  { name: 'Miles to KM Converter', href: '/miles-to-km/', description: 'Convert miles to kilometres instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Feet to CM Converter', href: '/feet-to-cm/', description: 'Convert feet to centimetres instantly.', icon: toolIconSvg['unit-converter'] },
];
---

<Layout title={title} description={description} activeTool="unit-converter" canonicalPath={canonicalPath} keywords={keywords} jsonLd={jsonLd} breadcrumbs={breadcrumbs} relatedTools={relatedTools}>
  <LongTailConverter
    mode="length"
    fromUnit="Kilometre"
    toUnit="Mile"
    defaultValue={1}
    seoIntro={`If you run, drive, cycle or travel between countries, converting kilometres to miles is a daily reality. The UK is in a unique spot: it still shows distances on road signs and speed limits in miles, yet almost everything else — races, cycle events, GPS apps and fitness trackers — is measured in kilometres. Cross the border into mainland Europe and every road sign flips to kilometres. Add to that the simple fact that running events are named after their kilometre distances, and you can see why a fast, accurate km to miles converter is genuinely useful rather than a gimmick.

The conversion factor is 1 kilometre equals 0.621371 miles. In everyday terms that means a kilometre is roughly five-eighths of a mile. To convert kilometres into miles, multiply the number of kilometres by 0.621371, or for a quick mental check use 0.62. So 1 km is 0.62 miles, 5 km is 3.107 miles, 10 km is 6.214 miles, and the classic marathon distance of 42.195 km works out at about 26.2 miles. A half marathon of 21.1 km is 13.1 miles. The reverse is just as easy — a mile equals 1.609 kilometres, so 5 miles is roughly 8 km.

The maths is not the whole story, though. This conversion genuinely matters when you travel. Rental cars across Europe show their speedometers in km/h, and if you are used to miles per hour, knowing that 100 km/h is about 62 mph, and 120 km/h is about 75 mph, keeps you safe and legal on the motorway. Runners use it constantly: parkrun and most UK 5K and 10K events are kilometre-based, but you will hear times discussed in miles, so a quick conversion helps you compare your pace. Cyclists planning audax or sportive routes across borders need both systems at a glance.

A couple of things trip people up. Speed and distance are not interchangeable — do not mix up km/h and mph when setting a treadmill or judging how long a journey will take. Also, for anything where precision matters, avoid rounding the factor down too aggressively; using 0.6 instead of 0.621371 will underestimate a 100 km journey by more than two miles. It helps to hold a few landmark distances in your head. A 5K parkrun is 3.1 miles, the "10K" every charity event promises is 6.2 miles, and a typical British urban commute of 15 km is around 9.3 miles. If you are driving from London to Edinburgh, the roughly 650 km route works out at about 404 miles. Trail and road sign distances in kilometres convert neatly too: 1.6 km is a mile, 3.2 km is two miles, and so on, so you can multiply miles by 1.6 for a close mental approximation of kilometres. Whether you are setting a training target, planning a continental road trip or simply comparing how far you have walked today, this converter gives you the accurate figure both ways instantly, so the numbers you need are right here.`}
    faqs={[
      { q: 'How many miles are in a kilometre?', a: '1 kilometre equals 0.621371 miles. To convert km to miles, multiply by 0.621371. To convert miles to km, multiply by 1.609.' },
      { q: 'How far is a 5K in miles?', a: 'A 5K is 5 kilometres = 3.107 miles. A 10K is 6.214 miles. These are standard race distances worldwide.' },
      { q: 'What is a half marathon in miles?', a: 'A half marathon is 21.1 km = 13.1 miles. A full marathon is 42.195 km = 26.2 miles.' },
      { q: 'What is 100 km in miles?', a: '100 km = 62.14 miles. This is a common distance for road trips, endurance cycling and long-distance events.' },
      { q: 'How do I convert km/h to mph?', a: 'Multiply km/h by 0.621371. So 100 km/h = 62.1 mph, and 120 km/h = 74.6 mph. Useful for speed limits when driving abroad.' },
      { q: 'Why does the UK use miles while most of Europe uses kilometres?', a: 'The UK never completed its switch to metric for road travel. Distances and speed limits on UK roads are still in miles, although most other measurements are metric.' },
      { q: 'What is a quick way to estimate km to miles?', a: 'Multiply the kilometres by 0.6 (or use five-eighths). So 10 km is roughly 6 miles. For precision use 0.621371 or this converter.' },
      { q: 'How many kilometres are in a mile?', a: '1 mile = 1.60934 kilometres. To convert miles to km, multiply by 1.609. So 5 miles is about 8 km.' },
      { q: 'What is 42.2 km in miles?', a: 'A marathon of 42.195 km equals 26.219 miles, usually rounded to 26.2 miles.' },
      { q: 'Is 100 mph the same as 100 km/h?', a: 'No. 100 mph = 160.9 km/h, while 100 km/h = 62.1 mph. They are very different speeds, so never mix the two on a treadmill or a car dashboard.' },
    ]}
  />
</Layout>
