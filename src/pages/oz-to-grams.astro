---
import Layout from '../layouts/Layout.astro';
import { toolIconSvg } from '../lib/tools';
import LongTailConverter from '../components/LongTailConverter.astro';

const title = 'Ounces to Grams Converter — oz to g';
const description = 'Convert ounces to grams instantly. Free oz to grams calculator — 1 oz = 28.3495 g. Enter any weight to see the exact grams conversion.';
const canonicalPath = '/oz-to-grams';
const keywords = ['oz to grams', 'ounces to grams', 'oz to g', 'ounce to gram', 'weight converter'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Redd Tools Ounces to Grams Converter',
  description,
  url: 'https://reddtools.com/oz-to-grams',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Unit Converter', href: '/unit-converter/weight' },
  { name: 'oz to grams' },
];

const relatedTools = [
  { name: 'Weight Converter', href: '/unit-converter/weight', description: 'Convert between ounces, grams, kg, lbs, stones and more.', icon: toolIconSvg['unit-converter'] },
  { name: 'KG to LBS Converter', href: '/kg-to-lbs', description: 'Convert kilograms to pounds instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Pounds to KG Converter', href: '/pounds-to-kg', description: 'Convert pounds to kilograms instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'Miles to KM Converter', href: '/miles-to-km', description: 'Convert miles to kilometres instantly.', icon: toolIconSvg['unit-converter'] },
];
---

<Layout title={title} description={description} activeTool="unit-converter" canonicalPath={canonicalPath} keywords={keywords} jsonLd={jsonLd} breadcrumbs={breadcrumbs} relatedTools={relatedTools}>
  <LongTailConverter
    mode="weight"
    fromUnit="Ounce"
    toUnit="Gram"
    defaultValue={1}
    seoIntro={`Weighing ingredients, postage, supplements, gold or herbs are all moments when you need a dependable ounces-to-grams conversion, and it is one of the most frequently searched weight conversions on the web. The ounce and the gram belong to different weighing systems: the ounce is the everyday weight unit in the imperial and US customary systems, while the gram is the base unit of mass in the metric system used for recipes, retail and science almost everywhere else. Whenever a US recipe is followed in a metric kitchen, or a parcel is weighed across systems, the two need reconciling. Baking, in particular, depends on getting weights right — the difference between a few grams can be the difference between a light cake and a dense one.

The relationship is exact: one ounce equals 28.349523125 grams, normally rounded to 28.35 grams. To convert ounces to grams you multiply the number of ounces by 28.35. Going back the other way, divide grams by 28.35, or multiply by 0.03527, to get ounces. So 1 oz is about 28 g, 4 oz is 113.40 g, 8 oz is 226.80 g, and 16 oz is 453.59 g — which is exactly one pound, which is why a pound is so often called 16 ounces in the US. Half an ounce is 14.17 g, and 2 oz is 56.70 g, both common in small retail and baking. A quarter ounce comes out at about 7.09 g. These are the sort of figures you will recognise again and again once you start weighing things in both units, from food portions to postal items. Understanding a handful of these anchor values makes it far easier to glance at a label or a recipe and judge roughly what you are dealing with, even before you reach for a converter.

For cooking, precision really matters. A recipe asking for 3 oz of flour or 1.5 oz of butter converts to 85 g and 42.5 g respectively, and using a rounded guess can noticeably change a bake or a sauce. The same applies to nutritional tracking, where a few grams either way affects calorie and macro counts. This converter gives exact gram figures for any ounce value, and works in both directions, so it is equally useful for converting gram-based European recipes back to ounces, or for weighing food portions, jewellery, postage or supplements.

Whether you are baking from a US cookbook, portioning out food, weighing a package for shipping, or checking the weight of a gold or silver item, this tool delivers an accurate, instant answer, removing the guesswork and the risk of a costly mis-measurement. The instant two-way conversion means you never have to work out the arithmetic yourself, and you can trust the result for anything from a delicate bake to an expensive purchase.`}
    faqs={[
      { q: 'How many grams are in an ounce?', a: 'One ounce is exactly 28.3495 grams. To convert ounces to grams, multiply the number of ounces by 28.35. To convert back, divide grams by 28.35, or multiply grams by 0.03527 to get ounces.' },
      { q: 'How many ounces are in 100 grams?', a: '100 grams is 3.53 ounces. This is a very common cooking conversion — 100 g of butter, flour or sugar is roughly 3.5 oz, so it is useful when following a recipe written in the other unit.' },
      { q: 'What is 16 ounces in grams?', a: '16 ounces is exactly 453.59 grams, which is one pound. This is why, in the US, a pound is so often referred to as 16 oz, especially for meat, cheese and produce.' },
      { q: 'How many grams in half an ounce?', a: 'Half an ounce is 14.7 grams (0.5 × 28.35 = 14.17 g to be exact). A quarter ounce is about 7.09 g, both handy for small quantities in baking and retail.' },
      { q: 'How do I convert ounces to grams in my head?', a: 'Multiply the ounces by 28.35 for an accurate figure, or multiply by 30 and subtract a little for a quick estimate. For example, 4 oz × 28.35 is 113.4 g; as an estimate, 4 × 30 = 120, minus about 5%, gives roughly 114 g.' },
      { q: 'How many grams are in 4 ounces?', a: '4 ounces is 113.40 grams. Four ounces is a very common serving size in US recipes, equal to about a quarter of a pound or roughly half a standard cup for many ingredients.' },
      { q: 'What is the difference between a fluid ounce and an ounce?', a: 'A fluid ounce measures volume (liquid) while an ounce measures weight (mass). They are different: 1 fluid ounce of water weighs about 1.04 oz, but a fluid ounce of oil weighs less. This converter deals with weight ounces.' },
      { q: 'How many ounces in a kilogram?', a: 'A kilogram is 35.27 ounces. Since 1000 g divided by 28.35 gives 35.27, there are about 35.27 ounces in every kilogram — useful for comparing metric and imperial package sizes.' },
      { q: 'Why do recipes use ounces instead of grams?', a: 'US recipes traditionally list dry ingredients in ounces and cups rather than grams, because the imperial system is the standard in American home cooking. Grams give more exact, reproducible results, which is why many chefs prefer them.' },
      { q: 'How accurate is this ounces to grams converter?', a: 'The converter uses the exact international factor of 28.3495 grams per ounce, so results are precise to several decimal places — more than enough for baking, weighing, postage and jewellery.' },
    ]}
  />
</Layout>
