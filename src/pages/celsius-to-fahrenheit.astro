---
import Layout from '../layouts/Layout.astro';
import { toolIconSvg } from '../lib/tools';
import LongTailConverter from '../components/LongTailConverter.astro';

const title = 'Celsius to Fahrenheit Converter — °C to °F';
const description = 'Convert Celsius to Fahrenheit instantly. Free °C to °F calculator — the formula is °F = (°C × 9/5) + 32. Enter any temperature to see the exact Fahrenheit value.';
const canonicalPath = '/celsius-to-fahrenheit';
const keywords = ['celsius to fahrenheit', 'c to f', 'celsius to f', '°c to °f', 'temperature converter'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Redd Tools Celsius to Fahrenheit Converter',
  description,
  url: 'https://reddtools.com/celsius-to-fahrenheit',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Unit Converter', href: '/unit-converter/temperature' },
  { name: 'Celsius to Fahrenheit' },
];

const relatedTools = [
  { name: 'Temperature Converter', href: '/unit-converter/temperature', description: 'Convert between Celsius, Fahrenheit and Kelvin.', icon: toolIconSvg['unit-converter'] },
  { name: 'Fahrenheit to Celsius', href: '/fahrenheit-to-celsius', description: 'Convert °F to °C instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'kg to lbs Converter', href: '/kg-to-lbs', description: 'Convert kilograms to pounds instantly.', icon: toolIconSvg['unit-converter'] },
  { name: 'miles to km Converter', href: '/miles-to-km', description: 'Convert miles to kilometres instantly.', icon: toolIconSvg['unit-converter'] },
];
---

<Layout title={title} description={description} activeTool="unit-converter" canonicalPath={canonicalPath} keywords={keywords} jsonLd={jsonLd} breadcrumbs={breadcrumbs} relatedTools={relatedTools}>
  <LongTailConverter
    mode="temperature"
    fromUnit="Celsius"
    toUnit="Fahrenheit"
    defaultValue={20}
    seoIntro={`Converting Celsius to Fahrenheit is one of the most common temperature calculations in the world, and this free tool does it instantly and exactly. The reason this conversion comes up so often is that the world is split between two temperature scales: most countries measure weather and cooking in Celsius, while the United States, Belize, and a handful of others use Fahrenheit. Whenever you read a recipe from abroad, check a forecast for a different country, or travel, you end up needing to move between the two.

The formula is: °F = (°C × 9/5) + 32. You multiply the Celsius value by 9/5 (or 1.8) and then add 32. So 20°C becomes (20 × 1.8) + 32 = 68°F, 0°C becomes 32°F (the freezing point of water), and 100°C becomes 212°F (the boiling point of water at sea level). These two anchor points — freezing and boiling — are the easiest way to sanity-check any conversion, because they never change.

A useful real-world reference table: 0°C = 32°F (freezing), 10°C = 50°F (cool day), 20°C = 68°F (mild room temperature), 25°C = 77°F (warm and pleasant), 30°C = 86°F (hot day), 37°C = 98.6°F (human body temperature), and 40°C = 104°F (very hot). If you memorise these anchor points, you can quickly estimate any temperature in the range that matters for everyday life.

For a quick mental estimate when you do not need precision, double the Celsius value and add 30. So 20°C → (20 × 2) + 30 = 70°F, very close to the exact 68°F. This rule of thumb is accurate enough for choosing clothing or checking if it is warm outside, but for cooking, medicine, or science use the exact formula or this converter.

In the kitchen, conversions matter because oven temperatures are set in different scales. A recipe saying "bake at 180°C" is 356°F for an American oven, and "350°F" is 177°C for everyone else. Getting this right is the difference between a perfectly baked cake and one that is burned on the outside and raw inside. Enter any temperature below to see the exact Fahrenheit equivalent instantly.`}
    faqs={[
      { q: 'How do I convert Celsius to Fahrenheit?', a: '°F = (°C × 9/5) + 32. For example, 20°C = (20 × 1.8) + 32 = 68°F. Multiply the Celsius value by 1.8, then add 32.' },
      { q: 'What is 0 degrees Celsius in Fahrenheit?', a: '0°C = 32°F. This is the freezing point of water — the two scales cross at -40° (-40°C = -40°F).' },
      { q: 'What is 100 degrees Celsius in Fahrenheit?', a: '100°C = 212°F. This is the boiling point of water at sea level.' },
      { q: 'How do I estimate °F from °C quickly?', a: 'Double the Celsius temperature and add 30. So 20°C → (20 × 2) + 30 = 70°F. The exact answer is 68°F — close enough for everyday use.' },
      { q: 'What is 37 degrees Celsius in Fahrenheit?', a: '37°C = 98.6°F, which is normal human body temperature. This is a useful medical anchor: a fever is usually 38°C or 100.4°F and above.' },
      { q: 'How do I convert an oven temperature?', a: 'Common oven temperatures: 160°C = 320°F, 180°C = 356°F, 200°C = 392°F, 220°C = 428°F. Use the exact formula for precise baking results.' },
    ]}
  />
</Layout>
