---
import Layout from '../../../layouts/Layout.astro';

const title = 'Technical Minimalism — Free Design System Kit';
const description = 'A monochrome, typography-first design system: Inter + IBM Plex Mono, 4px cards, hairline borders, functional accents. Download the spec and live preview — free.';
const canonicalPath = '/design-systems/technical-minimalism/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Technical Minimalism Design System Kit',
  url: 'https://reddtools.com/design-systems/technical-minimalism/',
  license: 'https://opensource.org/license/mit/',
  description,
};
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} activeNav="design-systems">
  <div class="detail">
    <div class="crumb"><a href="/design-systems/">← All design systems</a></div>

    <div class="detail-hero">
      <div class="badge-row">
        <span class="mono-badge"><span class="live-dot"></span>Kit 01</span>
        <span class="mono-badge">Free · No attribution</span>
      </div>
      <h1>Technical Minimalism</h1>
      <p class="lede">A monochrome, typography-first design system — the one this very site is built on. Black, white, and greys; Inter for reading, IBM Plex Mono uppercase micro-labels for voice. Colour appears only where it means something: focus, selection, status.</p>

      <div class="download-row">
        <a class="btn primary" href="/design-systems/technical-minimalism/Redd%20Tools%20%E2%80%94%20Technical%20Minimalism.md" download="Redd Tools — Technical Minimalism.md">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M12 3v12"/><polyline points="6 11 12 17 18 11"/><path d="M4 21h16"/></svg>
          Download the spec (.md)
        </a>
        <a class="btn ghost" href="/design-systems/technical-minimalism/preview.html" download="Redd Tools — Technical Minimalism (preview).html">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M12 3v12"/><polyline points="6 11 12 17 18 11"/><path d="M4 21h16"/></svg>
          Download preview.html
        </a>
        <a class="btn ghost" href="/design-systems/technical-minimalism/preview.html" target="_blank" rel="noopener">Open live preview ↗</a>
      </div>
    </div>

    <div class="spec-grid">
      <div class="spec-card">
        <span class="spec-label">Fonts</span>
        <p class="spec-value">Inter 400/500/600</p>
        <p class="spec-value">IBM Plex Mono 400/500</p>
      </div>
      <div class="spec-card">
        <span class="spec-label">Surfaces</span>
        <p class="spec-value">#f5f5f5 bg · #ffffff cards</p>
      </div>
      <div class="spec-card">
        <span class="spec-label">Radius</span>
        <p class="spec-value">4px cards · 9999px pills</p>
      </div>
      <div class="spec-card">
        <span class="spec-label">Motion</span>
        <p class="spec-value">150ms / 200ms ease</p>
      </div>
    </div>

    <div class="preview-block">
      <span class="spec-label block">Live preview</span>
      <div class="preview-frame">
        <iframe src="/design-systems/technical-minimalism/preview.html" title="Technical Minimalism live preview" loading="lazy"></iframe>
      </div>
      <p class="preview-note">The kit applied, end to end — type ramp, colour chips, cards, controls, motion. This is the exact file you download.</p>
    </div>

    <div class="usage">
      <span class="spec-label block">How to use it</span>
      <ol>
        <li>Download both files. The spec keeps the <code>Redd Tools — [Name].md</code> naming so kits never collide on disk. <code>Redd Tools — Technical Minimalism.md</code> is the spec; <code>preview.html</code> is the reference implementation with every token as a CSS variable.</li>
        <li>Copy the <code>:root</code> variables from <code>preview.html</code> into your project — they carry the whole system.</li>
        <li>Load Inter + IBM Plex Mono from Google Fonts (weights 400/500/600 and 400/500), or self-host.</li>
        <li>Follow the component rules: 4px radii, hairline borders, hover = darker border + lifted shadow, never a colour change.</li>
      </ol>
      <p class="license-note">MIT licensed. Use it for client work, products, anything — no attribution needed.</p>
    </div>
  </div>
</Layout>

<style>
  .detail { max-width: 960px; margin: 0 auto; padding: 32px 24px 96px; color: #000; }
  .crumb a { font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: #999; text-decoration: none; }
  .crumb a:hover { opacity: 0.6; }

  .detail-hero { margin-top: 24px; }
  .badge-row { display: flex; gap: 12px; margin-bottom: 16px; }
  .mono-badge { display: inline-flex; align-items: center; gap: 6px; font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: #999; border: 1px solid #d0d0d0; border-radius: 9999px; padding: 4px 12px; }
  .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #0afa14; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 400; letter-spacing: -0.02em; margin: 0 0 12px; }
  .lede { font-size: 18px; color: #5b5b5b; max-width: 60ch; margin: 0 0 24px; }

  .download-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 40px; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; font-size: 14px; font-weight: 500; border-radius: 4px; text-decoration: none; cursor: pointer; transition: opacity 150ms ease; border: 1px solid #000; }
  .btn:hover { opacity: 0.6; }
  .btn.primary { background: #000; color: #fff; }
  .btn.ghost { background: transparent; color: #000; }

  .spec-grid { display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 40px; }
  @media (min-width: 768px) { .spec-grid { grid-template-columns: repeat(4, 1fr); } }
  .spec-card { background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 4px; padding: 16px; }
  .spec-label { font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: #999; }
  .spec-label.block { display: block; margin-bottom: 12px; }
  .spec-value { font-size: 14px; font-weight: 500; margin: 8px 0 0; }

  .preview-block { margin-bottom: 48px; }
  .preview-frame { border: 1px solid rgba(0,0,0,0.08); border-radius: 4px; background: #fff; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.06); }
  .preview-frame iframe { width: 100%; height: 640px; border: 0; display: block; }
  .preview-note { font-size: 14px; color: #5b5b5b; margin: 12px 0 0; }

  .usage ol { font-size: 16px; line-height: 1.6; color: #333; padding-left: 20px; margin: 0 0 16px; }
  .usage code { font-family: 'IBM Plex Mono', monospace; font-size: 13px; background: #ebebeb; padding: 1px 6px; border-radius: 3px; }
  .license-note { font-size: 14px; color: #5b5b5b; margin: 0; }
</style>
