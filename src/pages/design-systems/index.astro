---
import Layout from '../../layouts/Layout.astro';

const title = 'Free Design Systems — Copy-Paste Design System Kits';
const description = 'Free copy-paste design systems: fonts, colour tokens, type ramps, spacing and component rules, with a live HTML preview. A new kit every two weeks.';
const canonicalPath = '/design-systems/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'ReddTools Design Systems',
  url: 'https://reddtools.com/design-systems/',
  description,
};

const kits = [
  {
    slug: 'technical-minimalism',
    name: 'Technical Minimalism',
    tagline: 'Monochrome, typography-first. Inter + IBM Plex Mono, 4px cards, hairline borders.',
    tags: ['MONOCHROME', 'INTER', 'UTILITY'],
    accent: 'live',
  },
  {
    slug: 'coming-soon',
    name: 'Kit #2 — shipping in 2 weeks',
    tagline: 'The next design system kit lands here on the biweekly cadence.',
    tags: ['NEXT UP'],
    coming: true,
  },
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd} activeNav="design-systems">
  <div class="page-hero">
    <div class="beta-badge">
      <span class="pulse-dot"></span>
      <span>1 design system · new every 2 weeks</span>
    </div>
    <h1>free design systems,<br>designed properly.</h1>
    <p class="hero-subtitle">Copy-paste design system kits: the spec (fonts, colour tokens, type ramp, spacing, component rules) plus a live HTML preview. MIT-free to use — no signup, no attribution needed.</p>
  </div>

  <div class="how">
    <h2 class="section-label">How it works</h2>
    <div class="how-grid">
      <div class="how-step"><span class="step-num">01</span><h3>Pick a design system</h3><p>Each kit is one complete design system — the spec, the tokens, and a working preview.</p></div>
      <div class="how-step"><span class="step-num">02</span><h3>Download the files</h3><p>One spec markdown plus preview.html, the reference implementation.</p></div>
      <div class="how-step"><span class="step-num">03</span><h3>Ship it</h3><p>Copy tokens into your project, swap fonts if you like, done. Free for anything.</p></div>
    </div>
  </div>

  <h2 class="section-label">Design systems</h2>
  <div class="kit-grid">
    {kits.filter(kit => !kit.coming).map((kit) => (
      <a href={`/design-systems/${kit.slug}/`} class="kit-card">
        <div class="kit-swatch">
          <svg class="card-icon" viewBox="0 0 64 64" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 46V18l10-4 15 6 10-4v28l-10 4-15-6-10 4"/><path d="M22 14v28"/><path d="M37 20v28"/></svg>
        </div>
        <div class="kit-body">
          <div class="kit-title-row">
            <h3>{kit.name}</h3>
            <span class="kit-live"><span class="live-dot"></span>KIT 01</span>
          </div>
          <p>{kit.tagline}</p>
          <div class="kit-tags">{kit.tags.map(t => <span>{t}</span>)}</div>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .page-hero { padding: 64px 24px 24px; max-width: 1440px; margin: 0 auto; }
  .beta-badge { display: inline-flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: #999; margin-bottom: 16px; }
  .pulse-dot { width: 6px; height: 6px; border-radius: 50%; background: #0afa14; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  h1 { font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 400; letter-spacing: -0.02em; margin: 0 0 12px; }
  .hero-subtitle { font-size: 20px; color: #5b5b5b; max-width: 55ch; margin: 0; }
  .section-label { font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: #999; max-width: 1440px; margin: 40px auto 16px; padding: 0 24px; }

  .kit-grid { display: grid; grid-template-columns: 1fr; gap: 16px; max-width: 1440px; margin: 0 auto; padding: 0 24px 24px; }
  @media (min-width: 768px) { .kit-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .kit-grid { grid-template-columns: repeat(3, 1fr); } }

  .kit-card { display: flex; flex-direction: column; background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 4px; box-shadow: 0 1px 2px rgba(0,0,0,0.06); overflow: hidden; text-decoration: none; color: #000; transition: border-color 200ms ease, box-shadow 200ms ease; }
  .kit-card:hover { border-color: rgba(0,0,0,0.15); box-shadow: 0 3px 8px rgba(0,0,0,0.15); }
  .kit-card:hover h3 { color: rgba(0,0,0,0.6); }
  .kit-card.coming { border-style: dashed; box-shadow: none; background: transparent; }
  .kit-swatch { display: flex; align-items: center; justify-content: center; height: 120px; background: #f5f5f5; border-bottom: 1px solid rgba(0,0,0,0.04); }
  .kit-swatch.dim { background: #fafafa; }
  .card-icon { width: 48px; height: 48px; }
  .kit-body { padding: 24px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .kit-title-row { display: flex; align-items: center; justify-content: space-between; }
  h3 { font-size: 20px; font-weight: 500; margin: 0; transition: color 200ms ease; }
  .kit-live { font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: #999; display: inline-flex; align-items: center; gap: 6px; }
  .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #0afa14; animation: pulse 2s infinite; }
  .kit-body p { font-size: 14px; color: #5b5b5b; margin: 0; flex: 1; }
  .kit-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .kit-tags span { font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: #999; border: 1px solid #d0d0d0; border-radius: 9999px; padding: 3px 10px; }

  .how { max-width: 1440px; margin: 0 auto 64px; padding: 0 24px; }
  .how-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 768px) { .how-grid { grid-template-columns: repeat(3, 1fr); } }
  .how-step { background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 4px; padding: 24px; }
  .step-num { font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 500; color: #999; letter-spacing: 0.08em; }
  .how-step h3 { font-size: 17px; font-weight: 500; margin: 8px 0 4px; }
  .how-step p { font-size: 14px; color: #5b5b5b; margin: 0; }
</style>
